# SubSentry environment — placeholders ONLY. Never put real values here.
# Copy to `.env` and fill in your own values. `.env` is gitignored.
# Sandbox credentials come from developer.paypal.com (PayPal Developer
# dashboard -> Apps & Credentials -> Sandbox). Never use live credentials.

DATABASE_URL=sqlite:///./subsentry.db
SECRET_KEY=change-me-to-a-long-random-string
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=mock
LLM_PROVIDER=template
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VITE_API_URL=http://localhost:8000
